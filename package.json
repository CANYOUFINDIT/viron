{
  "name": "viron",
  "version": "0.1.6",
  "private": true,
  "license": "Apache-2.0",
  "author": "futongyong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CANYOUFINDIT/viron.git"
  },
  "bugs": {
    "url": "https://github.com/CANYOUFINDIT/viron/issues"
  },
  "homepage": "https://github.com/CANYOUFINDIT/viron#readme",
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:desktop": "vite build --mode desktop && tsc -p tsconfig.desktop.json",
    "verify:desktop-startup": "node scripts/verify-desktop-startup.mjs",
    "verify:user-flow-integration": "npm run build && node scripts/verify-user-flows.mjs",
    "verify:user-flows": "npm run verify:user-flow-integration",
    "verify:full-regression": "npm run typecheck && npm test && npm run verify:user-flow-integration && npm run build:desktop && npm run verify:desktop-startup",
    "build:monitor": "bash scripts/build-viron-monitor.sh",
    "package:macos": "bash scripts/package-macos.sh",
    "package:macos:arm64": "bash scripts/package-macos.sh --arch=arm64",
    "package:macos:intel": "bash scripts/package-macos.sh --arch=x64",
    "package:macos:all": "bash scripts/package-macos.sh --all",
    "package:windows:x86": "node scripts/package-windows.mjs --arch=ia32",
    "package:windows:x64": "node scripts/package-windows.mjs --arch=x64",
    "package:windows:arm64": "node scripts/package-windows.mjs --arch=arm64",
    "package:windows:all": "npm run package:windows:x86 && npm run package:windows:x64 && npm run package:windows:arm64",
    "package:desktop:requested": "npm run package:macos:all && npm run package:windows:all",
    "package:current-os": "node scripts/package-current-os.mjs",
    "package:release": "bash scripts/package-release.sh",
    "start": "node scripts/start.mjs",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "test": "vitest run",
    "verify:database-navicat": "node scripts/verify-database-navicat-interactions.mjs",
    "service": "bash scripts/dev-service.sh",
    "admin:reset": "tsx src/server/cli/reset-admin-password.ts",
    "user:migrate": "tsx src/server/cli/migrate-user-system.ts",
    "database:migrate:mysql": "tsx src/server/cli/migrate-sqlite-to-mysql.ts",
    "secret:generate": "node scripts/generate-secret.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.2.0",
    "@lucide/vue": "^1.24.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "argon2": "^0.44.0",
    "bcrypt-pbkdf": "^1.0.2",
    "better-sqlite3": "^12.11.1",
    "croner": "^9.1.0",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.2.3",
    "element-plus": "^2.14.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.3.6",
    "fastify": "^5.10.0",
    "gsap": "^3.15.0",
    "html-to-image": "1.11.11",
    "ioredis": "^5.11.1",
    "markdown-it": "^14.3.0",
    "monaco-editor": "0.53.0",
    "mysql2": "^3.23.0",
    "playwright-core": "^1.61.1",
    "sql-formatter": "^15.8.2",
    "ssh2": "^1.17.0",
    "tabulator-tables": "^6.5.2",
    "vue": "^3.5.40",
    "vue-router": "^4.6.3",
    "ws": "^8.21.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zmodem.js": "^0.1.10",
    "zod": "^4.4.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.19.0",
    "@types/ssh2": "^1.15.5",
    "@types/tabulator-tables": "^6.3.6",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.2.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.11.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  }
}
