[Unit]
Description=Viron host and service monitor
After=local-fs.target

[Service]
Type=simple
User=root
Group=viron-monitor
EnvironmentFile=-/etc/viron-monitor/viron-monitor.env
ExecStart=/usr/local/bin/viron-monitor run
Restart=on-failure
RestartSec=5s
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/viron-monitor /run/viron-monitor
RuntimeDirectory=viron-monitor
RuntimeDirectoryMode=0770
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
