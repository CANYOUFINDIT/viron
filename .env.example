PORT=8080
HOST=127.0.0.1
DATA_DIR=./data
DATABASE_DRIVER=sqlite
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=viron
# DATABASE_USERNAME=viron
# DATABASE_PASSWORD=replace-with-strong-password
# DATABASE_POOL_SIZE=10
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Change-me-before-start-1
ALLOW_WEAK_PASSWORDS=false
SESSION_TTL_HOURS=1080
CONNECTION_IDLE_MINUTES=30
USER_CONNECTION_LIMIT=30
AUDIT_RETENTION_DAYS=30
VIRON_MONITOR_PULL_INTERVAL_SECONDS=60
WEB_CLIENT_ENABLED=true
VIRON_MCP_ENABLED=false
# 源码模式默认使用 ./dist/monitor；服务镜像已内置 /app/monitor。
# VIRON_MONITOR_PACKAGE_DIR=./dist/monitor
WEB_SESSION_EXECUTOR=server
# WEB_BROWSER_EXECUTABLE=/usr/bin/chromium
WEB_VIEW_TOTAL_LIMIT=8
COOKIE_SECURE=false

# Web 手工下载与 App 自动更新共同扫描 DATA_DIR/installers/，无需单独配置安装包路径。
# 只发布文件名版本与当前服务一致、且平台和架构可识别的根层非空 .dmg/.exe 文件。
