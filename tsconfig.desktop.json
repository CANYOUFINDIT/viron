{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "types": ["node", "electron"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/desktop/**/*.ts", "src/desktop/**/*.cts", "src/shared/**/*.ts"]
}
